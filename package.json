{
  "name": "n8n-nodes-hypersender",
  "version": "0.1.1",
  "description": "n8n nodes for Hypersender: send WhatsApp messages from your own number, SMS from your Android phone and OTP codes, and start workflows from WhatsApp and SMS events",
  "license": "MIT",
  "homepage": "https://github.com/hypersender/n8n-nodes-hypersender",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "hypersender",
    "whatsapp",
    "sms",
    "otp",
    "whatsapp-api",
    "sms-gateway"
  ],
  "author": {
    "name": "Hypersender",
    "email": "support@hypersender.com",
    "url": "https://hypersender.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hypersender/n8n-nodes-hypersender"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/HypersenderApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Hypersender/Hypersender.node.js",
      "dist/nodes/HypersenderTrigger/HypersenderTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^1.4.0",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/hypersender/n8n-nodes-hypersender/issues"
  }
}
